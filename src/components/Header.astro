---
---
<header class="site-header">
  <div class="container header-content">
    <a href="/" class="brand-link" title="Volver al catálogo principal">
      <img 
        src="/images/logo.webp" 
        alt="Logo Principal" 
        class="brand-logo-img" 
        onerror="this.onerror=null; this.src='/images/default-logo.webp';"
      />
      <div class="brand-divider"></div>
      <span class="brand-title">Catálogo Privado</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--color-remax-blue);
    box-shadow: var(--shadow-sm);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px; /* Cambiado a 70px */
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .brand-divider {
    width: 1px;
    height: 24px;
    background-color: var(--color-border);
  }

  .brand-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .header-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-remax-blue);
    background-color: #eff6ff;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid #bfdbfe;
  }
</style>