---
import type { Project, Company } from '../types/index';

interface Props {
  project: Project;
  company?: Company;
}

const { project, company } = Astro.props;

const etapaLabelMap: Record<string, string> = {
  en_planos: 'En planos',
  en_construccion: 'En construcción',
  entrega_inmediata: 'Entrega inmediata'
};

const etapaTexto = project.etapa ? etapaLabelMap[project.etapa] : null;
const fechaTexto = project.fechaEntrega ? project.fechaEntrega.texto : null;

const etapaFechaBadge = [etapaTexto, fechaTexto].filter(Boolean).join(' | ');

const precioFormateado = project.precioMin 
  ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 }).format(project.precioMin)
  : null;

const habitacionesTexto = project.habitaciones && project.habitaciones.length > 0
  ? `${project.habitaciones.join(', ')} hab.`
  : null;

const dataHabitaciones = project.habitaciones ? project.habitaciones.join(',') : '';
const dataAnio = project.fechaEntrega ? project.fechaEntrega.anio : (project.etapa === 'entrega_inmediata' ? '0' : '');
---

<a 
  href={`/proyectos/${project.slug}`} 
  class="project-card"
  data-distrito={project.distrito.toLowerCase()}
  data-etapa={project.etapa || ''}
  data-habitaciones={dataHabitaciones}
  data-precio={project.precioMin || 0}
  data-anio={dataAnio}
>
  <!-- CONTENEDOR DE IMAGEN -->
  <div class="image-wrapper">
    <img 
      src={project.imagen} 
      alt={project.nombre}
      loading="lazy"
      class="project-image"
      onerror="this.onerror=null; this.src='/images/projects/default.webp';"
    />

    <!-- Logo Constructora Superpuesto (Solo Desktop) -->
    <div class="company-logo-badge">
      <img 
        src={company?.logo || `/images/companies/${project.empresaId.toLowerCase()}.webp`} 
        alt={company?.nombre || 'Constructora'}
        onerror="this.onerror=null; this.src='/images/companies/default.webp';"
      />
    </div>

    <!-- Gradiente + Etapa/Fecha Overlay (Solo Desktop) -->
    {etapaFechaBadge && (
      <div class="desktop-image-overlay">
        <span>{etapaFechaBadge}</span>
      </div>
    )}
  </div>

  <!-- CONTENEDOR DE INFORMACIÓN -->
  <div class="card-info">
    {etapaFechaBadge && (
      <p class="mobile-etapa-tag">{etapaFechaBadge}</p>
    )}

    <!-- Nombre a la izquierda -->
    <h2 class="project-name">{project.nombre}</h2>

    <p class="project-district">📍 {project.distrito}</p>
    {project.direccion && (
      <p class="project-address">{project.direccion}</p>
    )}

    <div class="project-specs">
      {habitacionesTexto && <span>{habitacionesTexto}</span>}
      {habitacionesTexto && project.areaMin && <span>·</span>}
      {project.areaMin && <span>Desde {project.areaMin} m²</span>}
    </div>

    {precioFormateado && (
      <div class="price-container">
        <span class="price-label">Desde</span>
        <span class="price-value">{precioFormateado}</span>
      </div>
    )}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: row;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-remax-blue);
  }

  .image-wrapper {
    position: relative;
    width: 120px;
    flex-shrink: 0;
    background-color: #e2e8f0;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  .company-logo-badge,
  .desktop-image-overlay {
    display: none;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 0.75rem 0.875rem;
  }

  /* Etapa en Mobile con color AZUL RE/MAX */
  .mobile-etapa-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-remax-blue);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  /* Nombre alineado a la izquierda */
  .project-name {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text-main);
    text-align: left;
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }

  .project-district {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
    text-align: left;
  }

  .project-address {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: left;
    margin-bottom: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-specs {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: auto;
    margin-bottom: 0.35rem;
  }

  .price-container {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    padding-top: 0.25rem;
    border-top: 1px dashed var(--color-border);
  }

  .price-label {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .price-value {
    font-size: 1.1rem;
    font-weight: 900;
    color: #0f172a;
  }

  @media (min-width: 1024px) {
    .project-card {
      flex-direction: column;
    }

    .image-wrapper {
      width: 100%;
    }

    .project-image {
      aspect-ratio: 1 / 1;
    }

    .company-logo-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 10px;
      left: 10px;
      width: 52px;
      height: 52px;
      background-color: #ffffff;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      padding: 3px;
      z-index: 2;
    }

    .company-logo-badge img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    /* Overlay Desktop: Mayúsculas y +2pt de tamaño (0.875rem) */
    .desktop-image-overlay {
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
      padding: 1.5rem 0.75rem 0.5rem;
      color: #ffffff;
      font-size: 0.875rem;
      text-transform: uppercase;
      font-weight: 700;
      text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }

    .mobile-etapa-tag {
      display: none;
    }

    .card-info {
      padding: 1.25rem;
    }

    .project-name {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
    }

    .price-value {
      font-size: 1.3rem;
    }
  }
</style>