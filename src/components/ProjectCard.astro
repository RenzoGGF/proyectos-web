---
import type { Project, Company } from '../types/index';

interface Props {
  project: Project;
  company?: Company;
}

const { project, company } = Astro.props;

// Formateadores
const etapaLabelMap: Record<string, string> = {
  en_planos: 'En planos',
  en_construccion: 'En construcción',
  entrega_inmediata: 'Entrega inmediata'
};

const etapaTexto = project.etapa ? etapaLabelMap[project.etapa] : null;

const precioFormateado = project.precioMin 
  ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 }).format(project.precioMin)
  : null;

const habitacionesTexto = project.habitaciones && project.habitaciones.length > 0
  ? `${project.habitaciones.join(', ')} hab.`
  : null;

// Preparación de data-attributes para filtrado en el cliente (Fase 3B)
const dataHabitaciones = project.habitaciones ? project.habitaciones.join(',') : '';
const dataAnio = project.fechaEntrega ? project.fechaEntrega.anio : (project.etapa === 'entrega_inmediata' ? '0' : '');
---

<a 
  href={`/proyectos/${project.slug}`} 
  class="project-card"
  data-distrito={project.distrito.toLowerCase()}
  data-etapa={project.etapa || ''}
  data-habitaciones={dataHabitaciones}
  data-precio={project.precioMin || 0}
  data-anio={dataAnio}
>
  <div class="image-container">
    <img 
      src={project.imagen} 
      alt={project.nombre}
      loading="lazy"
      class="project-image"
      onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100%\' height=\'100%\' fill=\'%23e2e8f0\'><text x=\'50%\' y=\'50%\' dominant-baseline=\'middle\' text-anchor=\'middle\' fill=\'%2364748b\' font-size=\'14\'>Imagen no disponible</text></svg>'"
    />
    {etapaTexto && (
      <span class="badge-etapa">{etapaTexto}</span>
    )}
  </div>

  <div class="card-content">
    <div class="company-row">
      <img 
        src={company?.logo || `/images/companies/${project.empresaId.toLowerCase()}.webp`} 
        alt={company?.nombre || 'Empresa'}
        class="company-logo"
        onerror="this.style.display='none'"
      />
      <span class="company-name">{company?.nombre || 'Inmobiliaria'}</span>
    </div>

    <h2 class="project-name">{project.nombre}</h2>
    <p class="project-district">📍 {project.distrito}</p>

    <div class="card-details">
      {project.fechaEntrega && (
        <div class="detail-item">
          <span class="detail-label">Entrega:</span>
          <span class="detail-value">{project.fechaEntrega.texto}</span>
        </div>
      )}

      {habitacionesTexto && (
        <div class="detail-item">
          <span class="detail-label">Habitaciones:</span>
          <span class="detail-value">{habitacionesTexto}</span>
        </div>
      )}

      {project.areaMin && (
        <div class="detail-item">
          <span class="detail-label">Área:</span>
          <span class="detail-value">Desde {project.areaMin} m²</span>
        </div>
      )}
    </div>

    {precioFormateado && (
      <div class="card-footer">
        <span class="price-label">Desde</span>
        <span class="price-value">{precioFormateado}</span>
      </div>
    )}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: #cbd5e1;
  }

  .image-container {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: #e2e8f0;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-etapa {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    backdrop-filter: blur(4px);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.25rem;
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .company-logo {
    width: 24px;
    height: 24px;
    object-fit: contain;
    border-radius: 4px;
  }

  .company-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .project-district {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .card-details {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border);
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
  }

  .detail-label {
    color: var(--color-text-muted);
  }

  .detail-value {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .price-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .price-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-main);
  }
</style>