---
import type { Company } from '../types/index';

interface Props {
  distritos: string[];
  aniosEntrega: number[];
  companies: Company[];
}

const { distritos, aniosEntrega, companies } = Astro.props;
---

<section class="filter-section">
  <!-- Cabecera con Toggle (Desktop y Mobile) -->
  <div class="filter-bar-header">
    <button type="button" id="btn-toggle-filters" class="toggle-btn" aria-expanded="true">
      <span class="btn-text">🔍 Filtros de Búsqueda</span>
      <span id="toggle-icon" class="icon">▲</span>
    </button>

    <button type="button" id="btn-reset-filters" class="btn-reset">
      Limpiar filtros
    </button>
  </div>

  <!-- Contenido Desplegable -->
  <div id="filter-content" class="filter-content">
    <div class="filter-grid">
      <!-- 1. Distrito -->
      <div class="filter-group">
        <label for="filter-distrito" class="filter-label">Distrito</label>
        <select id="filter-distrito" class="filter-select">
          <option value="">Todos los distritos</option>
          {distritos.map((d) => (
            <option value={d.toLowerCase()}>{d}</option>
          ))}
        </select>
      </div>

      <!-- 2. Empresa / Constructora -->
      <div class="filter-group">
        <label for="filter-empresa" class="filter-label">Inmobiliaria</label>
        <select id="filter-empresa" class="filter-select">
          <option value="">Todas las inmobiliarias</option>
          {companies.map((c) => (
            <option value={c.id.toLowerCase()}>{c.nombre}</option>
          ))}
        </select>
      </div>

      <!-- 3. Etapa -->
      <div class="filter-group">
        <label for="filter-etapa" class="filter-label">Etapa</label>
        <select id="filter-etapa" class="filter-select">
          <option value="">Todas las etapas</option>
          <option value="en_planos">En planos</option>
          <option value="en_construccion">En construcción</option>
          <option value="entrega_inmediata">Entrega inmediata</option>
        </select>
      </div>

      <!-- 4. Rango de Precios: [Min] - [Max] -->
      <div class="filter-group">
        <label class="filter-label">Precio (S/)</label>
        <div class="range-inputs">
          <input type="number" id="filter-precio-min" class="filter-input" placeholder="Mín" step="10000" min="0" />
          <span class="range-separator">-</span>
          <input type="number" id="filter-precio-max" class="filter-input" placeholder="Máx" step="10000" min="0" />
        </div>
      </div>

      <!-- 5. Rango de Entrega: [Desde] - [Hasta] -->
      <div class="filter-group">
        <label class="filter-label">Entrega (Año)</label>
        <div class="range-inputs">
          <select id="filter-anio-min" class="filter-select">
            <option value="">Desde</option>
            {aniosEntrega.map((a) => (
              <option value={a}>{a}</option>
            ))}
          </select>
          <span class="range-separator">-</span>
          <select id="filter-anio-max" class="filter-select">
            <option value="">Hasta</option>
            {aniosEntrega.map((a) => (
              <option value={a}>{a}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Habitaciones / Espacio -->
    <div class="filter-group-rooms">
      <span class="filter-label">Habitaciones / Espacio</span>
      <div class="checkbox-group">
        {[1, 2, 3, 4].map((num) => (
          <label class="checkbox-label">
            <input type="checkbox" name="filter-rooms" value={num} class="filter-checkbox" />
            <span>{num === 4 ? '4+ hab' : `${num} hab`}</span>
          </label>
        ))}
        <label class="checkbox-label">
          <input type="checkbox" name="filter-rooms" value="0" class="filter-checkbox" />
          <span>Oficina, local, otros</span>
        </label>
      </div>
    </div>
  </div>
</section>

<script>
  // Toggle interactivo (Desktop & Mobile)
  document.addEventListener('DOMContentLoaded', () => {
    const btnToggle = document.getElementById('btn-toggle-filters');
    const filterContent = document.getElementById('filter-content');
    const toggleIcon = document.getElementById('toggle-icon');

    btnToggle?.addEventListener('click', () => {
      if (filterContent && toggleIcon) {
        const isCollapsed = filterContent.classList.toggle('is-collapsed');
        btnToggle.setAttribute('aria-expanded', String(!isCollapsed));
        toggleIcon.textContent = isCollapsed ? '▼' : '▲';
      }
    });
  });
</script>

<style>
  .filter-section {
    background-color: var(--color-surface);
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05);
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .filter-bar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background-color: var(--color-surface);
    border-bottom: 1px solid #e2e8f0;
  }

  .toggle-btn {
    background: none;
    border: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-remax-blue);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-md);
    transition: background-color 0.2s ease;
  }

  .toggle-btn:hover {
    background-color: #eff6ff;
  }

  .icon {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .btn-reset {
    background: var(--color-remax-red);
    color: var(--color-surface);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border-radius: 50rem;
    padding: 7px;
    border: none;
  }

  .btn-reset:hover {
    background-color: #fef2f2;
  }

  .filter-content {
    padding: 1.25rem;
  }

  .filter-content.is-collapsed {
    display: none;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .filter-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .filter-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1200px) {
    .filter-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .range-inputs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .range-separator {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .filter-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23475569' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.65rem center;
    background-size: 0.9rem;
    padding-right: 2rem;
    cursor: pointer;
  }

  .filter-select, .filter-input {
    width: 100%;
    padding: 0.5rem 0.65rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-main);
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-md);
    background-color: #ffffff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .filter-select:hover, .filter-input:hover {
    border-color: #94a3b8;
  }

  .filter-select:focus, .filter-input:focus {
    border-color: var(--color-remax-blue);
    box-shadow: 0 0 0 3px rgba(0, 61, 165, 0.12);
  }

  .filter-group-rooms {
    padding-top: 0.75rem;
    border-top: 1px dashed #e2e8f0;
  }

  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
  }

  .filter-checkbox {
    accent-color: var(--color-remax-blue);
  }
</style>