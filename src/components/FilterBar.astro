---
interface Props {
  distritos: string[];
  aniosEntrega: number[];
}

const { distritos, aniosEntrega } = Astro.props;
---

<section class="filter-section">
  <div class="filter-header-mobile">
    <button type="button" id="btn-toggle-filters" class="toggle-mobile-btn">
      <span class="btn-text">🔍 Filtros de Búsqueda</span>
      <span id="toggle-icon" class="icon">▼</span>
    </button>
  </div>

  <div id="filter-content" class="filter-content is-collapsed-mobile">
    <div class="filter-header-desktop">
      <h3 class="filter-title">Filtros de Búsqueda</h3>
      <button type="button" id="btn-reset-filters" class="btn-reset">
        🔄 Limpiar filtros
      </button>
    </div>

    <div class="filter-grid">
      <!-- Distrito -->
      <div class="filter-group">
        <label for="filter-distrito" class="filter-label">Distrito</label>
        <select id="filter-distrito" class="filter-select">
          <option value="">Todos los distritos</option>
          {distritos.map((d) => (
            <option value={d.toLowerCase()}>{d}</option>
          ))}
        </select>
      </div>

      <!-- Etapa -->
      <div class="filter-group">
        <label for="filter-etapa" class="filter-label">Etapa</label>
        <select id="filter-etapa" class="filter-select">
          <option value="">Todas las etapas</option>
          <option value="en_planos">En planos</option>
          <option value="en_construccion">En construcción</option>
          <option value="entrega_inmediata">Entrega inmediata</option>
        </select>
      </div>

      <!-- Rango de Precios: [Min] - [Max] -->
      <div class="filter-group">
        <label class="filter-label">Precio (S/)</label>
        <div class="range-inputs">
          <input type="number" id="filter-precio-min" class="filter-input" placeholder="Mín" step="10000" min="0" />
          <span class="range-separator">-</span>
          <input type="number" id="filter-precio-max" class="filter-input" placeholder="Máx" step="10000" min="0" />
        </div>
      </div>

      <!-- Rango de Entrega: [Desde] - [Hasta] -->
      <div class="filter-group">
        <label class="filter-label">Entrega (Año)</label>
        <div class="range-inputs">
          <select id="filter-anio-min" class="filter-select">
            <option value="">Desde</option>
            {aniosEntrega.map((a) => (
              <option value={a}>{a}</option>
            ))}
          </select>
          <span class="range-separator">-</span>
          <select id="filter-anio-max" class="filter-select">
            <option value="">Hasta</option>
            {aniosEntrega.map((a) => (
              <option value={a}>{a}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Habitaciones -->
    <div class="filter-group-rooms">
      <span class="filter-label">Habitaciones</span>
      <div class="checkbox-group">
        {[1, 2, 3, 4].map((num) => (
          <label class="checkbox-label">
            <input type="checkbox" name="filter-rooms" value={num} class="filter-checkbox" />
            <span>{num === 4 ? '4+ hab' : `${num} hab`}</span>
          </label>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnToggle = document.getElementById('btn-toggle-filters');
    const filterContent = document.getElementById('filter-content');
    const toggleIcon = document.getElementById('toggle-icon');

    btnToggle?.addEventListener('click', () => {
      if (filterContent) {
        filterContent.classList.toggle('is-collapsed-mobile');
        const isCollapsed = filterContent.classList.contains('is-collapsed-mobile');
        if (toggleIcon) toggleIcon.textContent = isCollapsed ? '▼' : '▲';
      }
    });
  });
</script>

<style>
  .filter-section {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevated);
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .toggle-mobile-btn {
    width: 100%;
    padding: 0.875rem 1rem;
    background-color: var(--color-surface);
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-remax-blue);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .filter-header-mobile {
      display: none;
    }
  }

  .filter-content {
    padding: 1.25rem;
  }

  .filter-content.is-collapsed-mobile {
    display: none;
  }

  @media (min-width: 1024px) {
    .filter-content.is-collapsed-mobile {
      display: block !important;
    }
  }

  .filter-header-desktop {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .filter-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .btn-reset {
    background: none;
    border: none;
    color: var(--color-remax-red);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .filter-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .filter-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .range-inputs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .range-separator {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .filter-select, .filter-input {
    width: 100%;
    padding: 0.45rem 0.5rem;
    font-size: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: #ffffff;
    outline: none;
  }

  .filter-select:focus, .filter-input:focus {
    border-color: var(--color-remax-blue);
  }

  .filter-group-rooms {
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border);
  }

  .checkbox-group {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .filter-checkbox {
    accent-color: var(--color-remax-blue);
  }
</style>