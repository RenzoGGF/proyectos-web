---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

import projectsData from '../../data/projects.json';
import advisorsData from '../../data/advisors.json';
import companiesData from '../../data/companies.json';
import type { Project, Advisor, Company } from '../../types/index';

export async function getStaticPaths() {
  const projects = projectsData as Project[];
  const advisorsMap = new Map((advisorsData as Advisor[]).map((a) => [a.id, a]));
  const companiesMap = new Map((companiesData as Company[]).map((c) => [c.id, c]));

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      advisor: advisorsMap.get(project.asesorId),
      company: companiesMap.get(project.empresaId)
    }
  }));
}

interface Props {
  project: Project;
  advisor?: Advisor;
  company?: Company;
}

const { project, advisor, company } = Astro.props;

// CONFIGURACIÓN DE ENLACE DE STOCK PARA EDIFICA
const LINK_STOCK_EDIFICA = 'https://www.dropbox.com/scl/fo/zh8zyeea685724doeqfdb/AP9VG3fCPRxnTFj_dJ2M0Rc/a.%20Stock%20de%20inmuebles?dl=0&preview=Stock+Disponible.xlsm&rlkey=os4bsfj1if9iumcavw2m0lt48&subfolder_nav_tracking=1';

const esEdificaSur = 
  company?.nombre?.trim().toUpperCase() === 'EDIFICA INVERSIONES DEL SUR SAC' ||
  project.empresaId.toLowerCase().includes('edifica-inversiones-del-sur');

const etapaLabelMap: Record<string, string> = {
  en_planos: 'En planos',
  en_construccion: 'En construcción',
  entrega_inmediata: 'Entrega inmediata'
};

const precioFormateado = project.precioMin
  ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 }).format(project.precioMin)
  : null;
---

<BaseLayout title={`${project.nombre} - Catálogo Inmobiliario`}>
  <Header />

  <main class="container page-main">
    <a href="/" class="back-link">← Volver al catálogo</a>

    {project.estado === 'vencido' && (
      <div class="banner-vencido" role="alert">
        ⚠️ <strong>Aviso:</strong> Este proyecto se encuentra vencido y no está disponible en el catálogo activo.
      </div>
    )}

    <article class="project-detail">
      <header class="detail-header">
        <div class="title-company-wrapper">
          <div class="company-brand">
            <img 
              src={company?.logo || `/images/companies/${project.empresaId.toLowerCase()}.webp`} 
              alt={company?.nombre || 'Inmobiliaria'}
              class="company-logo-img"
              onerror="this.onerror=null; this.src='/images/companies/default.webp';"
            />
            <span class="company-name">{company?.nombre || 'Inmobiliaria'}</span>
          </div>
          <h1 class="project-title">{project.nombre}</h1>
          <p class="project-location">📍 {project.distrito} {project.direccion ? `— ${project.direccion}` : ''}</p>
        </div>

        {precioFormateado && (
          <div class="price-box">
            <span class="price-label">Precio desde</span>
            <span class="price-amount">{precioFormateado}</span>
          </div>
        )}
      </header>

      <div class="detail-grid">
        <!-- Imagen con Aspect Ratio 1:1 -->
        <div class="image-box">
          <img 
            src={project.imagen} 
            alt={project.nombre} 
            class="main-image"
            onerror="this.onerror=null; this.src='/images/projects/default.webp';"
          />
        </div>

        <div class="info-sidebar">
          <h3>Información del Proyecto</h3>
          <ul class="info-list">
            {project.etapa && (
              <li><span class="info-label">Etapa:</span> <strong>{etapaLabelMap[project.etapa]}</strong></li>
            )}
            {project.fechaEntrega && (
              <li><span class="info-label">Entrega:</span> <strong>{project.fechaEntrega.texto}</strong></li>
            )}
            {project.financiamiento && project.financiamiento.length > 0 && (
              <li><span class="info-label">Financiamiento:</span> <strong>{project.financiamiento.join(', ')}</strong></li>
            )}
            {project.tipologia && project.tipologia.length > 0 && (
              <li><span class="info-label">Tipología:</span> <strong>{project.tipologia.join(', ')}</strong></li>
            )}
            {project.habitaciones && project.habitaciones.length > 0 && (
              <li><span class="info-label">Habitaciones:</span> <strong>{project.habitaciones.join(', ')} hab.</strong></li>
            )}
            {project.banos && project.banos.length > 0 && (
              <li><span class="info-label">Baños:</span> <strong>{project.banos.join(', ')} baños</strong></li>
            )}
            {project.areaMin && (
              <li>
                <span class="info-label">Área:</span> 
                <strong>
                  {project.areaMin} m²{project.areaMax ? ` - ${project.areaMax} m²` : ''}
                </strong>
              </li>
            )}
            {project.pisosProyecto !== undefined && (
              <li><span class="info-label">Pisos del proyecto:</span> <strong>{project.pisosProyecto} pisos</strong></li>
            )}
            {project.disponibles !== undefined && (
              <li><span class="info-label">Unidades disponibles:</span> <strong>≥{project.disponibles}</strong></li>
            )}
          </ul>

          {advisor && (
            <div class="advisor-card">
              <h4>Asesor Responsable</h4>
              <p class="advisor-name">{advisor.nombre}</p>
              {advisor.telefono && (
                <p class="advisor-phone">📞 {advisor.telefono}</p>
              )}
            </div>
          )}

          <!-- BOTONES DE ACCIÓN EXTERNA: "VER DRIVE" PRIMERO, "VER STOCK" DEBAJO -->
          <div class="action-buttons">
            {project.enlace && (
              <a href={project.enlace} target="_blank" rel="noopener noreferrer" class="external-btn">
                🔗 Ver Drive / Web Oficial ↗
              </a>
            )}

            {esEdificaSur && (
              <a href={LINK_STOCK_EDIFICA} target="_blank" rel="noopener noreferrer" class="stock-btn">
                📋 Ver stock ↗
              </a>
            )}
          </div>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .page-main {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .back-link {
    display: inline-block;
    color: var(--color-remax-blue);
    text-decoration: none;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .banner-vencido {
    background-color: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .detail-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .company-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .company-logo-img {
    height: 28px;
    width: auto;
    object-fit: contain;
  }

  .company-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .project-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .project-location {
    font-size: 0.95rem;
    color: var(--color-text-main);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .price-box {
    background-color: var(--color-surface);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: inline-block;
  }

  .price-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .price-amount {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-text-main);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* IMAGEN: 100% en Mobile */
  .image-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #e2e8f0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* AJUSTE EXCLUSIVO PARA PC (>= 768px): Reducción del ~10% */
  @media (min-width: 768px) {
    .detail-grid {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }

    .image-box {
      width: 80%; /* Reducción del 10% en PC */
      max-width: 80%;
    }
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-sidebar h3 {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .info-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.4rem;
  }

  .info-label {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .advisor-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .advisor-card h4 {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .advisor-name {
    font-weight: 800;
    margin-top: 0.25rem;
  }

  .advisor-phone {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  /* CONTENEDOR DE BOTONES */
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* BOTÓN DRIVE / WEB (ROJO RE/MAX) */
  .external-btn {
    display: block;
    text-align: center;
    background-color: var(--color-remax-red);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 12px rgba(220, 28, 46, 0.25);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .external-btn:hover {
    background-color: #b91c1c;
    transform: translateY(-2px);
  }

  /* BOTÓN "VER STOCK" (AZUL RE/MAX) */
  .stock-btn {
    display: block;
    text-align: center;
    background-color: var(--color-remax-blue);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 12px rgba(0, 61, 165, 0.25);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .stock-btn:hover {
    background-color: var(--color-remax-dark);
    transform: translateY(-2px);
  }
</style>